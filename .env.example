# =============================================================================
# NuevaMente — Plantilla de configuración
# =============================================================================
# USO:   cp .env.example .env    y llenar las claves en .env
#
# ⚠  .env NUNCA se sube a Git. Sólo este archivo (.env.example) se versiona.
#    Verificar que .gitignore contenga la línea:  .env
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LLM REDACTOR  —  genera el contenido adaptado
# -----------------------------------------------------------------------------
# Es el que más calidad necesita. Aquí va el mejor modelo disponible.
#
# Valores admitidos: gemini | ollama | deepseek | anthropic | kimi
LLM_PROVIDER=gemini

# Identificador del modelo. Si se deja vacío, se usa el default del proveedor
# definido en llm_provider.py.
# ⚠ VERIFICAR el identificador exacto en la documentación del proveedor:
#   cambian cada pocas semanas. Anotar en el README cuál se usó.
LLM_MODEL=

# Temperatura baja = salidas más consistentes y reproducibles.
# Importante para la demo: reduce el riesgo R-09 (demo no reproducible).
LLM_TEMPERATURE=0.2

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2


# -----------------------------------------------------------------------------
# 2. LLM VERIFICADOR  —  calcula anclaje_fuente_score (decisión D-02)
# -----------------------------------------------------------------------------
# Su tarea es MUCHO más simple que la del redactor: sólo clasifica afirmaciones
# como soportada / parcial / no_soportada contra los chunks recuperados.
# No desperdiciar aquí el modelo caro. Puede ser local.
VERIFIER_PROVIDER=gemini
VERIFIER_MODEL=

# Temperatura 0: la verificación debe ser lo más determinista posible.
VERIFIER_TEMPERATURE=0.0


# -----------------------------------------------------------------------------
# 3. EMBEDDINGS  —  vectoriza los chunks
# -----------------------------------------------------------------------------
# ⚠ ESTE ES EL QUE MÁS CUOTA CONSUME: una llamada POR CADA CHUNK.
#   Un documento puede generar decenas o cientos.
#   RECOMENDACIÓN FUERTE: dejarlo en Ollama local (gratis, ilimitado, sin red).
#   Así la cuota gratuita del LLM se gasta sólo en generación.
#
# Valores admitidos: ollama | gemini
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=

# El RAG (src/rag/) no usa estas dos: los embeddings del plan son e5 por la
# API de Hugging Face (D-09) y se configuran en la sección 6.


# -----------------------------------------------------------------------------
# 4. CLAVES DE API  —  ⚠ NUNCA VERSIONAR ESTE BLOQUE CON VALORES REALES
# -----------------------------------------------------------------------------
# Sólo hace falta llenar la del proveedor que se esté usando.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=

# Token de Hugging Face para los embeddings e5 del RAG. Cada integrante usa
# el suyo. También se acepta HUGGINGFACEHUB_API_TOKEN.
HF_TOKEN=

# Ollama corre local, no necesita clave.
OLLAMA_BASE_URL=http://localhost:11434


# -----------------------------------------------------------------------------
# 5. UMBRALES DE PRODUCTO  —  decisión D-03 del Decision Gate
# -----------------------------------------------------------------------------
# Valor acordado por el equipo. El documento del Hackathon NO fija ninguno:
# esto debe quedar documentado como decisión propia en el README.
FIDELIDAD_UMBRAL=0.80
FIDELIDAD_MAX_REINTENTOS=1

# Cascada de fidelidad (src/fidelidad/): desde ALTA la afirmación se acepta
# sin LLM, bajo BAJA se rechaza sin LLM y en medio decide el juez. Las lee
# scripts/calibrar_e5.py (RAG); src/fidelidad/ usa por ahora estos mismos
# valores por defecto, y el Revisor (T3-03) los tomará de aquí.
# ⚠ PROVISIONALES: con e5, una ALTA de 0.85 aprueba sin juez 8 de las 10
#   afirmaciones inventadas del tema de la calibración del 29/09, que sugiere
#   0.8885 / 0.8457. Se deciden en T3-04 (06/10).
FIDELIDAD_BANDA_ALTA=0.85
FIDELIDAD_BANDA_BAJA=0.55


# -----------------------------------------------------------------------------
# 6. RAG
# -----------------------------------------------------------------------------
# src/rag/ tiene su propia configuración: la lista completa, con los valores
# por defecto, está en src/rag/configuracion.py. CHUNK_SIZE, CHUNK_OVERLAP y
# RETRIEVAL_TOP_K valen para los dos.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# Los chunks de menos de CHUNK_FUSION caracteres se unen a un vecino (0 lo
# desactiva) y los de menos de CHUNK_MINIMO que quedan sueltos no se indexan.
# Los dos entran en la firma del índice: cambiarlos obliga a reindexar.
CHUNK_FUSION=300
CHUNK_MINIMO=100

# Puntaje mínimo de un chunk para contar como relevante al recuperar (D-12).
# Calibrado con e5 el 29/09; el plan decía 0.78. No confundir con
# FIDELIDAD_UMBRAL (sección 5).
UMBRAL_RETRIEVAL=0.83

# Embeddings e5 por la API de Hugging Face (D-09); el token va en la sección 4.
EMBEDDINGS_MODELO=intfloat/multilingual-e5-base
EMBEDDINGS_PROVEEDOR=hf-inference
# Vacía = pipeline de feature-extraction del router de Hugging Face.
EMBEDDINGS_URL=
EMBEDDINGS_LOTE=32
EMBEDDINGS_TIMEOUT=30
EMBEDDINGS_REINTENTOS=3

# Índice persistente por documento (decisión D-07). VECTOR_STORE_PATH es el de
# src/config.py; el RAG guarda en CHROMA_PATH, relativo a la raíz del repo.
VECTOR_STORE_PATH=./data/vector_store
CHROMA_PATH=./chroma_db


# -----------------------------------------------------------------------------
# 7. OCI OBJECT STORAGE  —  requisito obligatorio del Hackathon
# -----------------------------------------------------------------------------
# ⚠ El bucket debe estar en la HOME REGION de la cuenta.
#   Always Free sólo aplica en la home region.
OCI_BUCKET_NAME=nuevamente-contenidos-educativos
OCI_NAMESPACE=
OCI_REGION=
OCI_CONFIG_PROFILE=DEFAULT

# Ruta al archivo de configuración del SDK de OCI.
# ⚠ Este archivo y la llave .pem tampoco se versionan.
OCI_CONFIG_FILE=~/.oci/config


# -----------------------------------------------------------------------------
# 8. APLICACIÓN
# -----------------------------------------------------------------------------
MAX_DOCUMENT_SIZE_MB=10
LOG_LEVEL=INFO
